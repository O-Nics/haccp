    public function test_requires_authentication_for_{{ modelLower }}_endpoints(): void
    {
        ${{ modelLower }} = {{ model }}::factory()->create();

        // Test index
        $this->getJson('/api/{{ modelPlural }}')
            ->assertStatus(401);

        // Test show
        $this->getJson("/api/{{ modelPlural }}/{${{ modelLower }}->id}")
            ->assertStatus(401);

        // Test store
        $this->postJson('/api/{{ modelPlural }}', [])
            ->assertStatus(401);

        // Test update
        $this->putJson("/api/{{ modelPlural }}/{${{ modelLower }}->id}", [])
            ->assertStatus(401);

        // Test destroy
        $this->deleteJson("/api/{{ modelPlural }}/{${{ modelLower }}->id}")
