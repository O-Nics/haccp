<?php

declare(strict_types=1);

namespace Tests\Feature\{{ model }};

use App\Models\{{ model }};
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class {{ model }}ShowTest extends TestCase
{
    use RefreshDatabase;

    private User $user;

    protected function setUp(): void
    {
        parent::setUp();

        $this->user = User::factory()->create();
    }

    public function test_can_show_{{ modelLower }}(): void
    {
        ${{ modelLower }} = {{ model }}::factory()->create();

        $response = $this->actingAs($this->user)
            ->getJson("/api/{{ modelPlural }}/{${{ modelLower }}->id}");

        $response->assertStatus(200)
            ->assertJsonStructure([
                'data' => [
                    'id',
                    // Add your {{ model }} fields here
                ],
            ])
            ->assertJson([
                'data' => [
                    'id' => ${{ modelLower }}->id,
                ],
            ]);
    }

    public function test_cannot_show_nonexistent_{{ modelLower }}(): void
    {
        $response = $this->actingAs($this->user)
            ->getJson('/api/{{ modelPlural }}/99999');

        $response->assertStatus(404);
    }

    public function test_requires_authentication_to_show_{{ modelLower }}(): void
    {
        ${{ modelLower }} = {{ model }}::factory()->create();

        $response = $this->getJson("/api/{{ modelPlural }}/{${{ modelLower }}->id}");

        $response->assertStatus(401);
    }
}
