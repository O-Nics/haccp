<?php

declare(strict_types=1);

namespace Tests\Feature\{{ model }};

use App\Models\{{ model }};
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class {{ model }}IndexTest extends TestCase
{
    use RefreshDatabase;

    private User $user;

    protected function setUp(): void
    {
        parent::setUp();

        $this->user = User::factory()->create();
    }

    public function test_can_list_{{ modelLower }}s(): void
    {
        {{ model }}::factory()->count(3)->create();

        $response = $this->actingAs($this->user)
            ->getJson('/api/{{ modelPlural }}');

        $response->assertStatus(200)
            ->assertJsonStructure([
                'data' => [
                    '*' => [
                        'id',
                        // Add your {{ model }} fields here
                    ],
                ],
                'links',
                'meta',
            ]);
    }

    public function test_can_list_{{ modelLower }}s_with_pagination(): void
    {
        {{ model }}::factory()->count(20)->create();

        $response = $this->actingAs($this->user)
            ->getJson('/api/{{ modelPlural }}?per_page=10');

        $response->assertStatus(200)
            ->assertJsonCount(10, 'data')
            ->assertJsonStructure([
                'data',
                'links' => [
                    'first',
                    'last',
                    'prev',
                    'next',
                ],
                'meta' => [
                    'current_page',
                    'from',
                    'last_page',
                    'per_page',
                    'to',
                    'total',
                ],
            ]);
    }

    public function test_returns_empty_list_when_no_{{ modelLower }}s_exist(): void
    {
        $response = $this->actingAs($this->user)
            ->getJson('/api/{{ modelPlural }}');

        $response->assertStatus(200)
            ->assertJsonCount(0, 'data');
    }

    public function test_requires_authentication_to_list_{{ modelLower }}s(): void
    {
        $response = $this->getJson('/api/{{ modelPlural }}');

        $response->assertStatus(401);
    }
}
